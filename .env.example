# Copie para .env.local e substitua os marcadores pelos dados do projeto Supabase.
# Obtenha o Project URL e a publishable key no painel do Supabase (Connect / API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<sua-chave-publicavel>
